{
    "description": "Fivetran Gemini CLI Extension",
    "mcp-servers": [
        {
            "args": [
                "${extensionPath}${/}dist${/}index.js"
            ],
            "command": "node",
            "cwd": "${extensionPath}",
            "env": {
                "FIVETRAN_API_KEY": "${FIVETRAN_API_KEY}",
                "FIVETRAN_API_SECRET": "${FIVETRAN_API_SECRET}"
            },
            "name": "Fivetran Extension"
        }
    ],
    "name": "devoteam-mcp-fivetran",
    "version": "0.1.0"
}
